# Port, auf dem dieser zweite Server lauscht (muss sich von backend/ unterscheiden,
# falls beide auf demselben Server laufen)
PORT=3006

# Cloudflare-Zugangsdaten fuer Workers AI (siehe DEPLOYMENT.md, Schritt 2+3)
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optionaler API-Key, den die iOS App im Header "X-API-Key" mitschicken muss.
# Leer lassen, um den Schutz zu deaktivieren.
API_KEY=

# Erlaubte Herkunft fuer CORS. "*" erlaubt alle (fuer eine native iOS App
# unkritisch, da keine Browser-Origin gesendet wird).
CORS_ORIGIN=*

# Maximal erlaubte Anfragen pro IP und Zeitfenster (Missbrauchsschutz)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
