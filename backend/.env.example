# Port, auf dem der Node-Server lauscht (Nginx proxied hierhin)
PORT=3005

# Optionaler API-Key. Wenn gesetzt, muss die App ihn im Header
# "X-API-Key" mitschicken. Leer lassen, um den Schutz zu deaktivieren.
API_KEY=

# Erlaubte Herkunft fuer CORS. "*" erlaubt alle (fuer eine native iOS App
# unkritisch, da keine Browser-Origin gesendet wird).
CORS_ORIGIN=*

# Maximal erlaubte Anfragen pro IP und Zeitfenster (Missbrauchsschutz)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
